# Copy this file to .env and edit values before running docker compose.

COMPOSE_PROJECT_NAME=local-llm-stack
TZ=Etc/UTC

# LAN binding. Use 127.0.0.1 for machine-local only, or 0.0.0.0 for LAN access.
BIND_HOST=0.0.0.0

# Secrets. Replace these before exposing the stack beyond your own machine.
LITELLM_MASTER_KEY=sk-change-me-local-router
LITELLM_SALT_KEY=change-me-32-random-chars-minimum
OPEN_WEBUI_SECRET_KEY=change-me-open-webui-secret
POSTGRES_PASSWORD=change-me-postgres
GRAFANA_ADMIN_PASSWORD=change-me-grafana

# Optional. Required for gated Hugging Face models.
HF_TOKEN=

# NVIDIA's vLLM image is preferred on this ARM64 GB10 host. The 25.09 tag is pinned for the installed 580-series driver. If it is unavailable,
# try a current vllm/vllm-openai image that supports linux/arm64 for your CUDA stack.
VLLM_IMAGE=nvcr.io/nvidia/vllm:25.09-py3
LITELLM_IMAGE=ghcr.io/berriai/litellm:main-latest
OPEN_WEBUI_IMAGE=ghcr.io/open-webui/open-webui:main

# Initial model set. Keep exact model IDs pinned once smoke-tested.
FAST_MODEL=Qwen/Qwen3-4B-Instruct-2507
BALANCED_MODEL=Qwen/Qwen3-14B
LARGE_MODEL=Qwen/Qwen3-32B
QWEN30A3B_MODEL=Qwen/Qwen3-30B-A3B-Instruct-2507
DEEPSEEK32B_MODEL=deepseek-ai/DeepSeek-R1-Distill-Qwen-32B
MISTRAL24B_MODEL=mistralai/Mistral-Small-3.2-24B-Instruct-2506
LORA_BASE_MODEL=Qwen/Qwen3-4B-Instruct-2507
LORA_ADAPTER_PATH=/models/adapters/qwen3-4b-smoke-lora/current
VISION_MODEL=Qwen/Qwen3-VL-4B-Instruct

# vLLM tuning defaults. Reduce max context if startup fails from memory pressure.
FAST_MAX_MODEL_LEN=32768
BALANCED_MAX_MODEL_LEN=32768
LARGE_MAX_MODEL_LEN=16384
QWEN30A3B_MAX_MODEL_LEN=32768
DEEPSEEK32B_MAX_MODEL_LEN=16384
MISTRAL24B_MAX_MODEL_LEN=32768
FAST_MAX_NUM_SEQS=4
FAST_MAX_NUM_BATCHED_TOKENS=8192
FAST_GPU_MEMORY_UTILIZATION=0.30
BALANCED_GPU_MEMORY_UTILIZATION=0.58
LARGE_GPU_MEMORY_UTILIZATION=0.88
QWEN30A3B_GPU_MEMORY_UTILIZATION=0.85
DEEPSEEK32B_GPU_MEMORY_UTILIZATION=0.88
MISTRAL24B_GPU_MEMORY_UTILIZATION=0.80
LORA_MAX_MODEL_LEN=32768
LORA_GPU_MEMORY_UTILIZATION=0.35
VISION_MAX_MODEL_LEN=32768
VISION_GPU_MEMORY_UTILIZATION=0.45

# Ports exposed on BIND_HOST.
OPEN_WEBUI_PORT=3000
LITELLM_PORT=4000
VLLM_FAST_PORT=8001
VLLM_BALANCED_PORT=8002
VLLM_LARGE_PORT=8003
VLLM_QWEN30A3B_PORT=8004
VLLM_DEEPSEEK32B_PORT=8005
VLLM_MISTRAL24B_PORT=8006
VLLM_LORA_PORT=8007
VLLM_VISION_PORT=8008
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
JUPYTER_PORT=8888


# Copy this file to .env and edit values before running docker compose.

COMPOSE_PROJECT_NAME=local-llm-stack
TZ=Etc/UTC

# Host binding. Keep 127.0.0.1 for machine-local only, or use 0.0.0.0 for LAN access.
BIND_HOST=127.0.0.1

# Secrets. `make init` replaces these placeholders in local .env.
LITELLM_MASTER_KEY=sk-change-me-local-router
LITELLM_SALT_KEY=change-me-32-random-chars-minimum
OPEN_WEBUI_SECRET_KEY=change-me-open-webui-secret
POSTGRES_PASSWORD=change-me-postgres
GRAFANA_ADMIN_PASSWORD=change-me-grafana
JUPYTER_TOKEN=change-me-jupyter-token

# Optional. Required for gated Hugging Face models.
HF_TOKEN=

# NVIDIA's vLLM image is preferred on this ARM64 GB10 host. The 25.09 tag is pinned for the installed 580-series driver. If it is unavailable,
# try a current vllm/vllm-openai image that supports linux/arm64 for your CUDA stack.
VLLM_IMAGE=nvcr.io/nvidia/vllm:25.09-py3
LITELLM_IMAGE=ghcr.io/berriai/litellm:main-latest
OPEN_WEBUI_IMAGE=ghcr.io/open-webui/open-webui:main

# Initial model set. Keep exact model IDs pinned once smoke-tested.
FAST_MODEL=Qwen/Qwen3-4B-Instruct-2507
BALANCED_MODEL=Qwen/Qwen3-14B
LARGE_MODEL=Qwen/Qwen3-32B
QWEN30A3B_MODEL=Qwen/Qwen3-30B-A3B-Instruct-2507
DEEPSEEK32B_MODEL=deepseek-ai/DeepSeek-R1-Distill-Qwen-32B
MISTRAL24B_MODEL=mistralai/Mistral-Small-3.2-24B-Instruct-2506
GPTOSS120B_MODEL=openai/gpt-oss-120b
LAGUNAS21_MODEL=poolside/Laguna-S-2.1-NVFP4
# Single-Spark DeepSeek V4 uses a host-native IQ2 engine rather than vLLM.
DEEPSEEKV4_ENGINE_REF=v0.5.3
DEEPSEEKV4_MODEL_REPO=antirez/deepseek-v4-gguf
DEEPSEEKV4_MODEL_FILE=DeepSeek-V4-Flash-IQ2XXS-w2Q2K-AProjQ8-SExpQ8-OutQ8-chat-v2-imatrix-0731.gguf
DEEPSEEKV4_DSPARK_REPO=bleysg/DeepSeek-V4-Flash-DSpark-drafter-GGUF
DEEPSEEKV4_DSPARK_FILE=DSpark-drafter-Q2K-Q8-0731.gguf
DEEPSEEKV4_BUILD_JOBS=4
LORA_BASE_MODEL=Qwen/Qwen3-4B-Instruct-2507
LORA_ADAPTER_PATH=/models/adapters/qwen3-4b-smoke-lora/current
VISION_MODEL=Qwen/Qwen3-VL-4B-Instruct

# vLLM tuning defaults. Reduce max context if startup fails from memory pressure.
FAST_MAX_MODEL_LEN=32768
BALANCED_MAX_MODEL_LEN=32768
LARGE_MAX_MODEL_LEN=16384
QWEN30A3B_MAX_MODEL_LEN=32768
DEEPSEEK32B_MAX_MODEL_LEN=16384
MISTRAL24B_MAX_MODEL_LEN=32768
GPTOSS120B_MAX_MODEL_LEN=8192
LAGUNAS21_MAX_MODEL_LEN=262144
DEEPSEEKV4_MAX_MODEL_LEN=65536
GPTOSS120B_MAX_NUM_SEQS=1
LAGUNAS21_MAX_NUM_SEQS=1
FAST_MAX_NUM_SEQS=4
FAST_MAX_NUM_BATCHED_TOKENS=8192
FAST_GPU_MEMORY_UTILIZATION=0.30
BALANCED_GPU_MEMORY_UTILIZATION=0.58
LARGE_GPU_MEMORY_UTILIZATION=0.88
QWEN30A3B_GPU_MEMORY_UTILIZATION=0.85
DEEPSEEK32B_GPU_MEMORY_UTILIZATION=0.88
MISTRAL24B_GPU_MEMORY_UTILIZATION=0.80
GPTOSS120B_GPU_MEMORY_UTILIZATION=0.92
LAGUNAS21_GPU_MEMORY_UTILIZATION=0.85
LAGUNAS21_CUTE_DSL_ARCH=sm_121a
LAGUNAS21_MAX_JOBS=4
# Laguna S 2.1 NVFP4 requires vLLM 0.25.0+ with Poolside parsers for native vLLM serving.
LAGUNAS21_VLLM_IMAGE=vllm/vllm-openai:v0.25.1
LORA_MAX_MODEL_LEN=32768
LORA_GPU_MEMORY_UTILIZATION=0.35
VISION_MAX_MODEL_LEN=32768
VISION_GPU_MEMORY_UTILIZATION=0.45

# Ports exposed on BIND_HOST.
OPEN_WEBUI_PORT=3000
LITELLM_PORT=4000
VLLM_FAST_PORT=8001
VLLM_BALANCED_PORT=8002
VLLM_LARGE_PORT=8003
VLLM_QWEN30A3B_PORT=8004
VLLM_DEEPSEEK32B_PORT=8005
VLLM_MISTRAL24B_PORT=8006
VLLM_LORA_PORT=8007
VLLM_VISION_PORT=8008
CONTEXT_GUARD_PORT=4010
CONTEXT_GUARD_UPSTREAM_BASE_URL=http://localhost:4000/v1
CONTEXT_GUARD_DEFAULT_OUTPUT_TOKENS=4096
CONTEXT_GUARD_MIN_OUTPUT_TOKENS=64
CONTEXT_GUARD_HEADROOM_TOKENS=2048
CONTEXT_GUARD_CHARS_PER_TOKEN=3.0
# Optional model=url overrides for native tokenizer endpoints.
CONTEXT_GUARD_TOKENIZER_BASE_URLS=
CONTEXT_GUARD_TOKENIZER_TIMEOUT=3.0
CONTEXT_GUARD_MAX_RETRIES=3
CONTEXT_GUARD_KEEP_LAST_MESSAGES=8
CONTEXT_GUARD_SUMMARY_TOKENS=512
CONTEXT_GUARD_COMPACT_MODEL=local-fast
CONTEXT_GUARD_COMPACT_SOURCE_CHARS=6000
# Optional comma-separated overrides, for example:
# CONTEXT_GUARD_MODEL_CONTEXTS=local-gpt-oss-120b:16384,local-fast:8192
CONTEXT_GUARD_MODEL_CONTEXTS=
VLLM_GPTOSS120B_PORT=8009
VLLM_LAGUNAS21_PORT=8010
DEEPSEEKV4_PORT=8011
# Leave empty to bind only to Docker's host bridge. Use 0.0.0.0 only on a trusted LAN.
DEEPSEEKV4_BIND_HOST=
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
JUPYTER_PORT=8888


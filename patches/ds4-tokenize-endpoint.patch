+static void handle_tokenize(server *s, int fd, const char *body) {
+    request req;
+    char err[160];
+    const int ctx_size = s->serial_boot_ctx;
+    if (!parse_chat_request(s->engine, s, body, s->default_tokens,
+                            ctx_size, &req, err, sizeof(err))) {
+        http_error(fd, s->enable_cors, 400, err);
+        return;
+    }
+
+    buf b = {0};
+    buf_printf(&b, "{\"count\":%d,\"max_model_len\":%d}\n",
+               req.prompt.len, ctx_size);
+    http_response(fd, s->enable_cors, 200, "application/json", b.ptr);
+    buf_free(&b);
+    request_free(&req);
+}

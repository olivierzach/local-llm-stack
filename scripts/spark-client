#!/usr/bin/env python3
"""Render profiles, open an SSH tunnel, or run a client in an isolated context."""
import argparse
import json
import os
from pathlib import Path
import socket
import shutil
import subprocess
import sys

ROOT = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(ROOT / "tools"))
from spark_cluster.clients import client_environment, profiles
from spark_cluster.cli import save_json
from spark_cluster.config import integer, read, require, validate_inventory


def main():
    p = argparse.ArgumentParser(description=__doc__)
    p.add_argument("action", choices=("render", "tunnel", "run"))
    p.add_argument("--node", required=True, help="gateway location, independent of model placement")
    p.add_argument("--inventory", type=Path, default=ROOT / "cluster/inventory.json")
    p.add_argument("--registry", type=Path)
    p.add_argument("--port", type=int, default=4110, help="local client/tunnel port")
    p.add_argument("--remote-port", type=int, default=4110)
    p.add_argument("--key-file", type=Path)
    p.add_argument("--output", type=Path)
    p.add_argument("--client", choices=("omp", "openclaw", "aichat", "llm"))
    # Arguments after -- belong entirely to the selected client.
    argv = sys.argv[1:]
    split = argv.index("--") if "--" in argv else len(argv)
    args = p.parse_args(argv[:split])
    rest = argv[split + 1:]
    inv = read(args.inventory)
    validate_inventory(inv)
    require(args.node in inv["nodes"], "unknown gateway node")
    node = inv["nodes"][args.node]
    integer(args.port, 1024, 65535)
    integer(args.remote_port, 1024, 65535)
    if args.action == "tunnel":
        require(socket.gethostname() != node["hostname"], "gateway is on this host; connect to its local port directly")
        command = ["ssh", "-N", "-T", "-o", "BatchMode=yes", "-o", "ExitOnForwardFailure=yes",
                   "-o", "ServerAliveInterval=15", "-o", "ServerAliveCountMax=3",
                   "-L", f"127.0.0.1:{args.port}:127.0.0.1:{args.remote_port}", node["ssh"]]
        return subprocess.call(command)
    output = args.output or ROOT / "data/cluster/clients" / args.node
    local_gateway = socket.gethostname() == node["hostname"]
    default_registry = (Path.home() / ".local/state/local-llm-cluster/gateway/config/registry.json"
                        if local_gateway else ROOT / "data/cluster/gateways" / args.node / "registry.json")
    registry = read(args.registry or default_registry)
    for path, value in profiles(registry, args.node, args.port).items():
        if path == "openclaw/openclaw.json":
            value["agents"]["defaults"]["workspace"] = str(output.resolve() / "openclaw/workspace")
        save_json(output / path, value)
    (output / "llm/default_model.txt").write_text("spark-" + args.node + "/" + sorted(registry["routes"])[0] + "\n")
    if args.action == "render":
        print(json.dumps({"profiles": str(output), "gateway": args.node, "port": args.port}))
        return 0
    require(args.client is not None, "run requires --client")
    key_path = args.key_file or (Path.home() / ".local/state/local-llm-cluster/gateway/api-key"
        if socket.gethostname() == node["hostname"] else ROOT / "data/cluster/gateways" / args.node / "api-key")
    require(key_path.is_file(), "gateway credential file missing; specify --key-file")
    key = key_path.read_text().strip()
    require(len(key) >= 24, "invalid gateway credential")
    env = dict(os.environ)
    env.update(client_environment(output, key))
    env["PATH"] = str(Path.home() / ".local/bin") + os.pathsep + env.get("PATH", "")
    node_runtime = Path.home() / ".local/opt/spark-client-node/22.23.2/bin"
    if args.client == "openclaw" and (node_runtime / "node").is_file():
        env["PATH"] = str(node_runtime) + os.pathsep + env["PATH"]
    # An inherited named OMP profile must not override this explicit directory.
    env.pop("OMP_PROFILE", None)
    if args.client == "aichat" and not shutil.which("aichat", path=env["PATH"]) and sys.platform == "linux":
        images = read(ROOT / "cluster/images.lock.json")["images"]
        image = next(i["id"] for i in images if i["tag"] == "local-llm-stack-aichat:latest")
        command = ["docker", "run", "--rm", "--pull", "never", "--network", "host", "-i",
                   "--user", f"{os.getuid()}:{os.getgid()}", "--env", "SPARK_API_KEY",
                   "--env", "AICHAT_CONFIG_DIR=/config", "--mount",
                   f"type=bind,src={output.resolve() / 'aichat'},dst=/config"]
        if sys.stdin.isatty() and sys.stdout.isatty(): command.append("-t")
        return subprocess.call([*command, image, *rest], env=env)
    return subprocess.call([args.client, *rest], env=env)


if __name__ == "__main__":
    try: sys.exit(main())
    except (ValueError, KeyError, TypeError, OSError) as exc:
        print(f"spark-client: {exc}", file=sys.stderr)
        sys.exit(1)
